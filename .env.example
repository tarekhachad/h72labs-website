# Optional. Overrides the origin used for canonical + link-preview URLs
# (og:url, og:image, twitter:image) — see src/lib/site.ts.
#
# Leave UNSET in Vercel Production: it falls back to https://h72labs.com, which
# is what the public build should advertise.
#
# SET it on Vercel Preview so a preview deployment advertises itself instead of
# production. Vercel exposes the generated hostname as VERCEL_URL, so the value
# to configure there is:
#   NEXT_PUBLIC_SITE_URL=https://$VERCEL_URL
#
# No other environment variables exist. The site is fully static: no database,
# no API keys, no secrets.
